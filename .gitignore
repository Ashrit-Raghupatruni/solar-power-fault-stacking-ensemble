# Ignore raw 100MB+ dataset CSV files (exceeds GitHub 100MB limit)
Database/**/*.csv
Database/*.csv
*.csv.zip
*.zip

# Ignore full-scale 1.8M processed partitions (exceeds GitHub 100MB limit)
data/processed/train.csv
data/processed/test.csv

