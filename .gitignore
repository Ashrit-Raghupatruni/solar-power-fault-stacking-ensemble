# Ignore raw 100MB+ dataset CSV files (exceeds GitHub 100MB limit)
Database/**/*.csv
Database/*.csv
*.csv.zip
*.zip

# Ignore full-scale 1.8M processed partitions (exceeds GitHub 100MB limit)
data/processed/train.csv
data/processed/test.csv
data/raw/

# Ignore large model checkpoint files (recommend storing via release artifacts / LFS)
models/**/*.pkl
models/*.pkl
*.pkl.gz

# Keep lightweight essential preprocessors and meta files if desired
!models/preprocessors/scaler.pkl
!models/**/meta.pkl

# Ignore large temporary files
temp.pkl
*.tmp
*.log

# Ignore Python caches & virtual environments
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
.env

# Testing & coverage caches
.pytest_cache/
.coverage
htmlcov/

# Matplotlib cache
.matplotlib/

# Jupyter Notebook checkpoints
.ipynb_checkpoints/

# Operating System files
.DS_Store
Thumbs.db
